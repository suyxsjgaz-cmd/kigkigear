# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BLACKCAT GATEWAY (Documentação oficial: https://docs.blackcatoficial.com)
# Chave de API Secreta da sua conta BlackCat (Header X-API-Key)
BLACKCAT_API_KEY="sua_chave_de_api_blackcat_aqui"
# URL base da API Blackcat de produção (https://api.blackcatoficial.com/api)
BLACKCAT_API_URL="https://api.blackcatoficial.com/api"

# UTMIFY (Rastreamento de Campanhas & Pedidos)
# ID do Pixel Público UTMify (ex: 65f1234abc...)
VITE_UTMIFY_PIXEL_ID="seu_pixel_id_utmify"
# Webhook da UTMify para envio automático de pedidos gerados/pagos
UTMIFY_WEBHOOK_URL="https://api.utmify.com.br/orders"
# Token de API UTMify (opcional, para envio via API S2S direta)
UTMIFY_API_TOKEN="seu_token_api_utmify"

# FLEVOPAY GATEWAY
FLEVO_API_URL="https://api.flevopagamentos.com"
FLEVO_API_KEY="flevopay_sk_..."
FLEVO_PRODUCT_HASH="seu_hash_do_produto"
FLEVO_ACCOUNT_ID="seu_id_da_conta"

